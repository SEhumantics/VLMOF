<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
  name="containment" nsURI="https://vlmof.example/evaluation/containment" nsPrefix="containment">
  <eClassifiers xsi:type="ecore:EClass" name="Root">
    <eStructuralFeatures xsi:type="ecore:EReference" name="children" upperBound="-1" unique="false"
      containment="true" eType="#//Child"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="left" containment="true" eType="#//Child"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="right" containment="true" eType="#//Child"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Child">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" lowerBound="1"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
</ecore:EPackage>
