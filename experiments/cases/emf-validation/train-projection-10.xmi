  <railway:Switch xmi:id="sw0" id="2" currentPosition="STRAIGHT" positions="p0"/>
  <railway:Sensor xmi:id="s0a" id="4"/><railway:Sensor xmi:id="s0b" id="5"/>
  <railway:Route xmi:id="r1" id="11" active="true" requires="s1a s1b"><follows xmi:id="p1" id="13" position="STRAIGHT" route="r1" target="sw1"/></railway:Route>
  <railway:Switch xmi:id="sw1" id="12" currentPosition="STRAIGHT" positions="p1"/>
  <railway:Sensor xmi:id="s1a" id="14"/><railway:Sensor xmi:id="s1b" id="15"/>
